; LAN MIC plugins Windows install script (Inno Setup 7, compatible with Inno Setup 6.3+)
; Compiled by scripts/make_installer.ps1:
;   ISCC.exe /DAppVersion=x.y.z installer_windows.iss
; Staging directory: dist\win-staging (generated by make_installer.ps1)
; Output:            dist\LANMIC_<version>.exe

#ifndef AppVersion
#define AppVersion "0.1.0"
#endif

#define AppName "LAN MIC Plugins"
#define AppPublisher "suxitech"
#define StagingDir "..\dist\win-staging"

[Setup]
AppId={{5C6B7A90-1E2D-4F3A-9B8C-7D6E5F4A3B2C}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
; Install directory is fixed to the VST3 standard directory; Vst3Dir() picks by privilege
DefaultDirName={code:Vst3Dir}
DirExistsWarning=no
AppendDefaultDirName=no
DisableDirPage=yes
; Lets the user choose "install for all users" (admin) or "install just for me" during setup
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=dialog commandline
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
OutputDir=..\dist
OutputBaseFilename=LANMIC_{#AppVersion}
Compression=lzma2
SolidCompression=yes
Uninstallable=yes
DisableProgramGroupPage=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; Copy the whole .vst3 bundle directory tree recursively
Source: "{#StagingDir}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Code]
// VST3 standard directories: admin -> C:\Program Files\Common Files\VST3
//                          user  -> %LOCALAPPDATA%\Programs\Common\VST3
function Vst3Dir(Param: string): string;
begin
    if IsAdminInstallMode then
        Result := ExpandConstant('{cf}\VST3')
    else
        Result := ExpandConstant('{localappdata}\Programs\Common\VST3');
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
    // Directory is fixed; skip the directory selection page.
    Result := (PageID = wpSelectDir);
end;
