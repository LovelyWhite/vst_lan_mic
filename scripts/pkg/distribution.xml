<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>@TITLE@</title>
    <options customize="never" require-scripts="false"/>
    <welcome file="welcome.txt"/>
    <choices-outline>
        <line choice="lanmic"/>
    </choices-outline>
    <choice id="lanmic" title="@TITLE@" start_selected="true">
        <pkg-ref id="@IDENT@"/>
    </choice>
    <pkg-ref id="@IDENT@" onConclusion="none">lanmic-component.pkg</pkg-ref>
</installer-gui-script>
