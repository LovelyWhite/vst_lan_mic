{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja, native architecture)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mac-universal",
      "displayName": "macOS Universal",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-universal",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "mac-universal", "configurePreset": "mac-universal" }
  ]
}
